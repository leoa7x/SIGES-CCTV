# Copy to .env.production. Never commit the resulting file.
COMPOSE_PROFILES=monitoring
NODE_ENV=production
SIGES_STRICT_PRODUCTION=true
# The deployment is accessed directly on the server LAN IP.
SIGES_SINGLE_HOST=true
# Bind public SIGES services on every interface. Set 127.0.0.1 only when a
# reverse proxy on this server is the sole public entry point.
SIGES_BIND_ADDRESS=0.0.0.0
# Used by docker-compose.lan.yml, which is the one-host HTTPS entrypoint
# described in the Windows offline deployment design.
SIGES_PUBLIC_HOST=siges.cctv.local

POSTGRES_USER=siges
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
POSTGRES_DB=siges_cctv
API_PORT=4001
WEB_PORT=3001
GRAFANA_PORT=3005

JWT_SECRET=REPLACE_WITH_A_32_BYTE_RANDOM_VALUE
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_32_BYTE_RANDOM_VALUE
CAMERA_SECRET_KEY=REPLACE_WITH_A_32_BYTE_RANDOM_VALUE
MONITOR_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_VALUE
NETWORK_TELEMETRY_INGEST_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE

# Created once with db:seed. This command creates no demo inventory.
SEED_ADMIN_EMAIL=admin@example.gov.co
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE

MINIO_USER=siges_minio
MINIO_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
MINIO_BUCKET=siges-cctv
MINIO_PUBLIC_URL=https://siges.cctv.local/storage

GRAFANA_ADMIN_USER=siges_admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
# Browser access is supported from this server and from other LAN computers.
CORS_ORIGIN=https://siges.cctv.local
NEXT_PUBLIC_API_URL=https://siges.cctv.local/api

# Single-host overlay overrides this to redpanda:9092. Keep this value only if
# moving later to a separate multi-broker Redpanda cluster.
REDPANDA_BROKERS=redpanda:9092

# ntopng must observe the production network and be reachable from this host.
NTOPNG_BASE_URL=http://host.docker.internal:3002
NTOPNG_USERNAME=REPLACE_WITH_A_SERVICE_ACCOUNT
NTOPNG_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
NTOPNG_COLLECTION_INTERVAL_SECONDS=20

# The CMC scan cadence. The launcher never enables a mock fallback in production.
CENTER_MONITORING_INTERVAL_MS=300000
CENTER_ASSET_STALE_MS=600000
HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_FAILURE_THRESHOLD=3
HEARTBEAT_CONCURRENCY=20
# After ICMP fails, verify network devices through their management ports.
HEARTBEAT_TCP_FALLBACK_PORTS=80,443,8291,8728
MONITOR_STATE_TRANSITIONS_ENABLED=false
# Cameras use a separate reachability cycle; this is not yet a video decode.
CAMERA_HEARTBEAT_INTERVAL_MS=30000
CAMERA_HEARTBEAT_PORTS=554,80,37777
LAN_ORANGUTAN_HOME=/app/tools/LAN-Orangutan
LAN_ORANGUTAN_CMD="python3 /app/apps/api/scripts/run_lan_orangutan_scan.py {target}"
LAN_DISCOVERY_AGENT_PORT=4010
LAN_DISCOVERY_AGENT_TOKEN=REPLACE_WITH_A_LONG_RANDOM_VALUE
# Name of the physical NIC connected to the CCTV LAN on the server, e.g. eth0.
LAN_DISCOVERY_INTERFACE=REPLACE_WITH_THE_CCTV_LAN_INTERFACE
