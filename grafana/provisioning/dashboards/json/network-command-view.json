      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "siges-postgres" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH samples AS (SELECT captured_at, node_id, total_bytes_in, total_bytes_out, LAG(total_bytes_in) OVER (PARTITION BY node_id ORDER BY captured_at) AS prev_in, LAG(total_bytes_out) OVER (PARTITION BY node_id ORDER BY captured_at) AS prev_out FROM telemetry_node_timeseries_view WHERE $__timeFilter(captured_at)) SELECT captured_at AS time, COALESCE(SUM(GREATEST(total_bytes_in - COALESCE(prev_in, total_bytes_in), 0)), 0) AS \"In (rx)\", COALESCE(SUM(GREATEST(total_bytes_out - COALESCE(prev_out, total_bytes_out), 0)), 0) AS \"Out (tx)\" FROM samples GROUP BY captured_at ORDER BY captured_at;",
          "refId": "A"
        }
      ],
      "title": "Tráfico agregado de red",
      "type": "timeseries"
    },
