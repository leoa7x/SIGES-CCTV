        {
          "datasource": { "type": "postgres", "uid": "siges-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT node_code AS \"Host\", COALESCE(route_identifier, 'Sin ruta') AS \"Ruta\", COALESCE(monitoring_center_name, 'Sin CMC') AS \"Centro\", COALESCE(active_alert_count, 0) AS \"Alertas\", CASE WHEN captured_at IS NULL OR captured_at < NOW() - INTERVAL '10 minutes' THEN 'OFFLINE' WHEN active_alert_count > 0 THEN 'DEGRADED' ELSE 'ONLINE' END AS \"Estado\" FROM telemetry_global_health_view ORDER BY CASE WHEN captured_at IS NULL OR captured_at < NOW() - INTERVAL '10 minutes' THEN 0 WHEN active_alert_count > 0 THEN 1 ELSE 2 END, active_alert_count DESC, node_code ASC LIMIT 100;",
          "refId": "A"
        }
      ],
      "title": "Estado de nodos monitoreados",
      "type": "table"
