        {
          "datasource": { "type": "postgres", "uid": "siges-postgres" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH base AS ( SELECT captured_at, GREATEST(total_bytes_in - COALESCE(LAG(total_bytes_in) OVER (PARTITION BY node_id ORDER BY captured_at), total_bytes_in), 0) AS bytes_in_delta, GREATEST(total_bytes_out - COALESCE(LAG(total_bytes_out) OVER (PARTITION BY node_id ORDER BY captured_at), total_bytes_out), 0) AS bytes_out_delta FROM telemetry_node_timeseries_view WHERE node_id = ${nodeId:sqlstring} AND $__timeFilter(captured_at) ) SELECT captured_at AS time, bytes_in_delta AS total_bytes_in, bytes_out_delta AS total_bytes_out FROM base ORDER BY captured_at;",
          "refId": "A"
        }
      ],
      "title": "Tráfico del nodo",
      "type": "timeseries"
    },
