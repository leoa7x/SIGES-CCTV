      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "siges-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH summary AS ( SELECT top_destinations_json::jsonb AS top_destinations_json FROM telemetry_node_summary_view WHERE node_id = ${nodeId:sqlstring} LIMIT 1 ) SELECT CONCAT(destination.value->>'target', ' (', destination.value->>'kind', ')') AS destino, COALESCE((destination.value->>'bytes')::numeric, 0) AS \"Bytes\", COALESCE((destination.value->>'flowCount')::numeric, 0) AS \"Flows\" FROM summary, LATERAL jsonb_array_elements(COALESCE(summary.top_destinations_json, '[]'::jsonb)) AS destination(value) ORDER BY \"Bytes\" DESC LIMIT 10;",
          "refId": "A"
        }
      ],
      "title": "Top destinos",
      "type": "barchart"
