      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "orientation": "horizontal",
        "tooltip": { "mode": "single" },
        "xField": "protocolo"
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "siges-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH summary AS ( SELECT top_protocols_json::jsonb AS top_protocols_json FROM telemetry_node_summary_view WHERE node_id = ${nodeId:sqlstring} LIMIT 1 ) SELECT protocol.value->>'name' AS protocolo, COALESCE((protocol.value->>'bytes')::numeric, 0) AS \"Bytes\", COALESCE((protocol.value->>'flowCount')::numeric, 0) AS \"Flows\" FROM summary, LATERAL jsonb_array_elements(COALESCE(summary.top_protocols_json, '[]'::jsonb)) AS protocol(value) ORDER BY \"Bytes\" DESC LIMIT 10;",
          "refId": "A"
        }
      ],
      "title": "Top protocolos",
      "type": "barchart"
    },
    {
      "datasource": { "type": "postgres", "uid": "siges-postgres" },
