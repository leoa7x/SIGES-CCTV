generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth / Users ─────────────────────────────────────────────────────────────

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  name           String?
  role           UserRole       @default(OPERATOR)
  state          EntityState    @default(ACTIVE)
  incidents      Incident[]     @relation("AssignedIncidents")
  logbookEntries LogbookEntry[]
  discoveryJobs  NodeDiscoveryJob[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
  OPERATOR
  TECHNICIAN
  VIEWER
}

// ─── Geographic hierarchy ─────────────────────────────────────────────────────

model City {
  id             String        @id @default(uuid())
  name           String
  type           GeoEntityType @default(MUNICIPALITY)
  department     String?
  daneCode       String?
  population     Int?
  areaSqKm       Float?
  contractObject String?
  logoUrl        String?
  lat            Float?
  lng            Float?
  state          EntityState   @default(ACTIVE)
  projects       Project[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Project {
  id          String             @id @default(uuid())
  name        String
  client      String
  contract    String?
  startDate   DateTime
  endDate     DateTime?
  state       EntityState        @default(ACTIVE)
  cityId      String
  city        City               @relation(fields: [cityId], references: [id])
  centers     MonitoringCenter[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model MonitoringCenter {
  id          String      @id @default(uuid())
  name        String
  address     String?
  phone       String?
  contactName String?
  lat         Float?
  lng         Float?
  state       EntityState @default(ACTIVE)
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id])
  routes      Route[]
  incidents   Incident[]  @relation("CenterIncidents")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ─── Network topology ─────────────────────────────────────────────────────────

model Route {
  id                 String           @id @default(uuid())
  identifier         String
  type               RouteType        @default(FIBER)
  state              EntityState      @default(ACTIVE)
  monitoringCenterId String
  center             MonitoringCenter @relation(fields: [monitoringCenterId], references: [id])
  nodes              Node[]
  fiberCables        FiberCable[]
  fiberPoints        FiberPoint[]
  spliceClosures     SpliceClosure[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

enum RouteType {
  FIBER
  WIRELESS
  HYBRID
}

model Node {
  id                  String                    @id @default(uuid())
  code                String                    @unique
  name                String
  lat                 Float
  lng                 Float
  address             String?
  ip                  String?
  primaryIp           String?
  scanSubnetCidr      String?
  mac                 String?
  nodeType            NodeType                  @default(OTHER)
  snmpCommunity       String?
  operativeState      NodeState                 @default(ONLINE)
  hasPole             Boolean                   @default(false)
  routeId             String
  route               Route                     @relation(fields: [routeId], references: [id])
  cameras             Camera[]
  fiberSegmentsA      FiberSegment[]            @relation("NodeA")
  fiberSegmentsB      FiberSegment[]            @relation("NodeB")
  fiberPoints         FiberPoint[]
  logbookEntries      LogbookEntry[]
  incidents           Incident[]                @relation("NodeIncidents")
  assets              NodeAsset[]
  discoveryJobs       NodeDiscoveryJob[]
  analyticsAssignments NodeAnalyticsAssignment[]
  telemetrySnapshots  NetworkTelemetrySnapshot[]
  telemetrySamples    NetworkTelemetryAssetSample[]
  telemetryAlerts     NetworkTelemetryAlert[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
}

enum NodeType {
  SWITCH
  CABINET
  AMPLIFIER
  SPLITTER
  OTHER
}

enum NodeState {
  ONLINE
  DEGRADED
  OFFLINE
  MAINTENANCE
}

enum NodeAssetType {
  CAMARA_PTZ
  CAMARA_FIJA
  SWITCH
  UPS
  OTHER
}

enum NodeAssetSource {
  MANUAL
  DISCOVERY
  DISCOVERY_ENRICHED
}

enum NodeDiscoveryStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum NodeDiscoveredDeviceStatus {
  DISCOVERED
  CONFIRMED
  DISMISSED
  MERGED
}

enum AnalyticsScope {
  NODE
  ASSET
  BOTH
}

enum NetworkTelemetryClassificationSource {
  OFFICIAL
  DISCOVERY
  UNMATCHED
}

enum NetworkTelemetryAlertKind {
  NODE_SILENT
  ASSET_SILENT
  UNMATCHED_TRAFFIC
  NEW_DESTINATION
}

enum NetworkTelemetryAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model NodeAsset {
  id                   String                        @id @default(uuid())
  nodeId               String
  node                 Node                          @relation(fields: [nodeId], references: [id])
  assetType            NodeAssetType
  name                 String
  ip                   String?
  mac                  String?                       @unique
  vendor               String?
  model                String?
  hostname             String?
  operativeState       NodeState                     @default(ONLINE)
  source               NodeAssetSource               @default(MANUAL)
  lastSeenAt           DateTime?
  notes                String?
  discoveredDevices    NodeDiscoveredDevice[]
  analyticsAssignments NodeAssetAnalyticsAssignment[]
  telemetrySamples    NetworkTelemetryAssetSample[]
  telemetryAlerts     NetworkTelemetryAlert[]
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@unique([nodeId, ip])
}

model NodeDiscoveryJob {
  id                String                 @id @default(uuid())
  nodeId            String
  node              Node                   @relation(fields: [nodeId], references: [id])
  status            NodeDiscoveryStatus    @default(PENDING)
  requestedByUserId String?
  requestedByUser   User?                  @relation(fields: [requestedByUserId], references: [id])
  targetIp          String?
  targetSubnetCidr  String?
  rawSummary        Json?
  errorMessage      String?
  discoveredDevices NodeDiscoveredDevice[]
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model NodeDiscoveredDevice {
  id                  String                     @id @default(uuid())
  nodeDiscoveryJobId  String
  nodeDiscoveryJob    NodeDiscoveryJob           @relation(fields: [nodeDiscoveryJobId], references: [id])
  candidateType       NodeAssetType?
  name                String?
  ip                  String?
  mac                 String?
  vendor              String?
  model               String?
  hostname            String?
  discoveryConfidence Int                        @default(0)
  status              NodeDiscoveredDeviceStatus @default(DISCOVERED)
  matchedAssetId      String?
  matchedAsset        NodeAsset?                 @relation(fields: [matchedAssetId], references: [id])
  rawPayload          Json?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
}

model AnalyticsCatalog {
  id                   String                        @id @default(uuid())
  code                 String                        @unique
  name                 String
  scope                AnalyticsScope                @default(BOTH)
  isCustom             Boolean                       @default(false)
  nodeAssignments      NodeAnalyticsAssignment[]
  assetAssignments     NodeAssetAnalyticsAssignment[]
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
}

model NodeAnalyticsAssignment {
  id                 String            @id @default(uuid())
  nodeId             String
  node               Node              @relation(fields: [nodeId], references: [id])
  analyticsCatalogId String
  analyticsCatalog   AnalyticsCatalog  @relation(fields: [analyticsCatalogId], references: [id])
  customLabel        String?
  isEnabled          Boolean           @default(true)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([nodeId, analyticsCatalogId, customLabel])
}

model NodeAssetAnalyticsAssignment {
  id                 String            @id @default(uuid())
  nodeAssetId        String
  nodeAsset          NodeAsset         @relation(fields: [nodeAssetId], references: [id])
  analyticsCatalogId String
  analyticsCatalog   AnalyticsCatalog  @relation(fields: [analyticsCatalogId], references: [id])
  customLabel        String?
  isEnabled          Boolean           @default(true)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([nodeAssetId, analyticsCatalogId, customLabel])
}

model NetworkTelemetrySnapshot {
  id                  String                        @id @default(uuid())
  nodeId              String
  node                Node                          @relation(fields: [nodeId], references: [id])
  collectorId         String
  capturedAt          DateTime
  windowSeconds       Int
  totalBytesIn        BigInt
  totalBytesOut       BigInt
  activeHosts         Int
  activeFlows         Int
  alertCount          Int                           @default(0)
  topProtocolsJson    Json
  topDestinationsJson Json
  assetSamples        NetworkTelemetryAssetSample[]
  alerts              NetworkTelemetryAlert[]
  createdAt           DateTime                      @default(now())

  @@index([nodeId, capturedAt])
}

model NetworkTelemetryAssetSample {
  id                   String                               @id @default(uuid())
  snapshotId           String
  snapshot             NetworkTelemetrySnapshot             @relation(fields: [snapshotId], references: [id])
  nodeId               String
  node                 Node                                 @relation(fields: [nodeId], references: [id])
  nodeAssetId          String?
  nodeAsset            NodeAsset?                           @relation(fields: [nodeAssetId], references: [id])
  ip                   String?
  mac                  String?
  hostname             String?
  bytesIn              BigInt
  bytesOut             BigInt
  flowCount            Int
  lastSeenAt           DateTime
  classificationSource NetworkTelemetryClassificationSource
  createdAt            DateTime                             @default(now())

  @@index([nodeId, createdAt])
  @@index([nodeAssetId])
}

model NetworkTelemetryAlert {
  id           String                        @id @default(uuid())
  nodeId       String
  node         Node                          @relation(fields: [nodeId], references: [id])
  snapshotId   String?
  snapshot     NetworkTelemetrySnapshot?     @relation(fields: [snapshotId], references: [id])
  nodeAssetId  String?
  nodeAsset    NodeAsset?                    @relation(fields: [nodeAssetId], references: [id])
  kind         NetworkTelemetryAlertKind
  severity     NetworkTelemetryAlertSeverity
  title        String
  detail       String
  metadataJson Json?
  firstSeenAt  DateTime
  lastSeenAt   DateTime
  isActive     Boolean                       @default(true)
  resolvedAt   DateTime?
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt

  @@index([nodeId, isActive])
  @@index([kind, isActive])
  @@unique([nodeId, kind, title])
}


model FiberSegment {
  id        String     @id @default(uuid())
  nodeAId   String
  nodeA     Node       @relation("NodeA", fields: [nodeAId], references: [id])
  nodeBId   String
  nodeB     Node       @relation("NodeB", fields: [nodeBId], references: [id])
  waypoints Json       @default("[]")
  state     FiberState @default(ACTIVE)
  lengthM   Float?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum FiberState {
  ACTIVE
  CUT
  DEGRADED
  MAINTENANCE
}

enum FiberCableKind {
  TRONCAL
  DERIVACION
}

enum FiberPointKind {
  NODE
  SPLICE
}

enum SpliceLegDirection {
  IN
  OUT
}

enum FiberConnectionBlockKind {
  FUSION
  RESERVE
  PASS_THROUGH
  SPLIT
}

enum FiberDocumentStatus {
  DRAFT
  PARTIAL
  DOCUMENTED
  VALIDATED
}

model FiberCable {
  id                 String              @id @default(uuid())
  routeId            String
  route              Route               @relation(fields: [routeId], references: [id])
  code               String
  kind               FiberCableKind      @default(TRONCAL)
  fiberCount         Int
  state              EntityState         @default(ACTIVE)
  documentStatus     FiberDocumentStatus @default(DRAFT)
  originPointId      String
  originPoint        FiberPoint          @relation("FiberCableOriginPoint", fields: [originPointId], references: [id])
  destinationPointId String
  destinationPoint   FiberPoint          @relation("FiberCableDestinationPoint", fields: [destinationPointId], references: [id])
  parentCableId      String?
  parentCable        FiberCable?         @relation("FiberCableParentChild", fields: [parentCableId], references: [id])
  childCables        FiberCable[]        @relation("FiberCableParentChild")
  sourceSpliceId     String?
  sourceSplice       SpliceClosure?      @relation("SpliceSourceCable", fields: [sourceSpliceId], references: [id])
  notes              String?
  spliceLegs         SpliceCableLeg[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([routeId, code])
}

model FiberPoint {
  id                String         @id @default(uuid())
  routeId           String
  route             Route          @relation(fields: [routeId], references: [id])
  kind              FiberPointKind
  name              String
  latitude          Float
  longitude         Float
  nodeId            String?
  node              Node?          @relation(fields: [nodeId], references: [id])
  spliceId          String?        @unique
  splice            SpliceClosure? @relation(fields: [spliceId], references: [id])
  originCables      FiberCable[]   @relation("FiberCableOriginPoint")
  destinationCables FiberCable[]   @relation("FiberCableDestinationPoint")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model SpliceClosure {
  id             String              @id @default(uuid())
  routeId        String
  route          Route               @relation(fields: [routeId], references: [id])
  code           String
  name           String
  closureType    String
  latitude       Float
  longitude      Float
  trayCount      Int
  fiberCapacity  Int
  notes          String?
  documentStatus FiberDocumentStatus @default(DRAFT)
  point          FiberPoint?
  cableLegs      SpliceCableLeg[]
  blockInputs    SpliceBlockInput[]
  connections    SpliceFiberConnection[]
  sourceCables   FiberCable[]        @relation("SpliceSourceCable")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([routeId, code])
}

model SpliceCableLeg {
  id                String                  @id @default(uuid())
  spliceId          String
  splice            SpliceClosure           @relation(fields: [spliceId], references: [id])
  fiberCableId      String
  fiberCable        FiberCable              @relation(fields: [fiberCableId], references: [id])
  direction         SpliceLegDirection
  bufferLabel       String?
  fiberCount        Int
  reservedFiberCount Int                    @default(0)
  notes             String?
  fromBlocks        SpliceBlockInput[]      @relation("BlockFromLeg")
  toBlocks          SpliceBlockInput[]      @relation("BlockToLeg")
  fromConnections   SpliceFiberConnection[] @relation("ConnectionFromLeg")
  toConnections     SpliceFiberConnection[] @relation("ConnectionToLeg")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

model SpliceBlockInput {
  id             String                   @id @default(uuid())
  spliceId       String
  splice         SpliceClosure            @relation(fields: [spliceId], references: [id])
  fromLegId      String
  fromLeg        SpliceCableLeg           @relation("BlockFromLeg", fields: [fromLegId], references: [id])
  fromFiberStart Int
  fromFiberEnd   Int
  toLegId        String
  toLeg          SpliceCableLeg           @relation("BlockToLeg", fields: [toLegId], references: [id])
  toFiberStart   Int
  toFiberEnd     Int
  blockKind      FiberConnectionBlockKind
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

model SpliceFiberConnection {
  id              String                   @id @default(uuid())
  spliceId        String
  splice          SpliceClosure            @relation(fields: [spliceId], references: [id])
  fromLegId       String
  fromLeg         SpliceCableLeg           @relation("ConnectionFromLeg", fields: [fromLegId], references: [id])
  fromFiberNumber Int
  toLegId         String
  toLeg           SpliceCableLeg           @relation("ConnectionToLeg", fields: [toLegId], references: [id])
  toFiberNumber   Int
  connectionKind  FiberConnectionBlockKind
  status          EntityState              @default(ACTIVE)
  notes           String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([spliceId, fromLegId, fromFiberNumber])
  @@unique([spliceId, toLegId, toFiberNumber])
}

// ─── Cameras ──────────────────────────────────────────────────────────────────

model Camera {
  id              String         @id @default(uuid())
  code            String         @unique
  name            String
  ip              String?
  brand           String?
  model           String?
  resolution      String?
  state           CameraState    @default(ONLINE)
  hasAnalytics    Boolean        @default(false)
  nodeId          String
  node            Node           @relation(fields: [nodeId], references: [id])
  incidents       Incident[]     @relation("CameraIncidents")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum CameraState {
  ONLINE
  OFFLINE
  DEGRADED
  MAINTENANCE
}

// ─── Incidents ────────────────────────────────────────────────────────────────

model Incident {
  id             String           @id @default(uuid())
  title          String
  description    String?
  status         IncidentStatus   @default(NEW)
  severity       IncidentSeverity @default(MEDIUM)
  detectedAt     DateTime         @default(now())
  resolvedAt     DateTime?
  solution       String?
  nodeId         String?
  node           Node?            @relation("NodeIncidents", fields: [nodeId], references: [id])
  cameraId       String?
  camera         Camera?          @relation("CameraIncidents", fields: [cameraId], references: [id])
  centerId       String?
  center         MonitoringCenter? @relation("CenterIncidents", fields: [centerId], references: [id])
  assignedUserId String?
  assignedUser   User?            @relation("AssignedIncidents", fields: [assignedUserId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

enum IncidentStatus {
  NEW
  IN_PROGRESS
  PENDING_PARTS
  RESOLVED
  CLOSED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─── Logbook ──────────────────────────────────────────────────────────────────

model LogbookEntry {
  id           String          @id @default(uuid())
  date         DateTime        @default(now())
  activityType ActivityType
  observations String?
  result       EntryResult     @default(SATISFACTORY)
  technicianId String
  technician   User            @relation(fields: [technicianId], references: [id])
  nodeId       String
  node         Node            @relation(fields: [nodeId], references: [id])
  createdAt    DateTime        @default(now())
}

enum ActivityType {
  PREVENTIVE_MAINTENANCE
  CORRECTIVE_MAINTENANCE
  INSPECTION
  INSTALLATION
  CONFIGURATION
  OTHER
}

enum EntryResult {
  SATISFACTORY
  PARTIAL
  FAILED
  PENDING
}

// ─── Monitor audit ────────────────────────────────────────────────────────────

model DeviceStateLog {
  id         String    @id @default(uuid())
  entityType String
  entityId   String
  oldState   String
  newState   String
  source     LogSource @default(MONITOR)
  createdAt  DateTime  @default(now())
}

enum LogSource {
  MONITOR
  MANUAL
}

// ─── Shared enums ─────────────────────────────────────────────────────────────

enum GeoEntityType {
  MUNICIPALITY
  DEPARTMENT
}

enum EntityState {
  ACTIVE
  INACTIVE
  ARCHIVED
}
