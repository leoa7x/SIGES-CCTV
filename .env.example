# ── PostgreSQL + PostGIS ──────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=siges
POSTGRES_PASSWORD=siges_pass_change_me
POSTGRES_DB=siges_cctv
DATABASE_URL=postgresql://siges:siges_pass_change_me@localhost:5434/siges_cctv

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Redpanda (Kafka-compatible) ───────────────────────────────────────────────
REDPANDA_BROKERS=localhost:9092

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_256bit_secret_in_production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_REFRESH_EXPIRES_IN=7d

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=4001
API_URL=http://localhost:4001
CORS_ORIGIN=http://localhost:3001

# ── Web ───────────────────────────────────────────────────────────────────────
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_APP_NAME=SIGES-CCTV

# ── Seed (first admin user) ───────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@sigescctv.co
SEED_ADMIN_PASSWORD=Admin1234!

# ── Monitor API ───────────────────────────────────────────────────────────────
MONITOR_API_TOKEN=change-me-in-production
