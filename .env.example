# ── PostgreSQL + PostGIS ──────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=siges
POSTGRES_PASSWORD=siges_pass_change_me
POSTGRES_DB=siges_cctv
DATABASE_URL=postgresql://siges:siges_pass_change_me@localhost:5432/siges_cctv

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=siges
RABBITMQ_PASSWORD=siges_pass_change_me
RABBITMQ_URL=amqp://siges:siges_pass_change_me@localhost:5672

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_256bit_secret_in_production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_REFRESH_EXPIRES_IN=7d

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# ── Web ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=SIGES-CCTV

# ── Seed (first admin user) ───────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@sigescctv.co
SEED_ADMIN_PASSWORD=Admin1234!
